{
  "name": "nodo-iot-admin",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manhpatrick/H-th-ng-IOT-th-ng-minh.git"
  },
  "type": "module",
  "description": "Smart home IoT: Express, MongoDB, MQTT, PWA and local anomaly detection",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "docker:up": "node deployment/start-local.js",
    "docker:mqtt": "node deployment/start-local.js --mqtt",
    "docker:mqtt:build": "node deployment/start-local.js --mqtt --build",
    "docker:build": "node deployment/start-local.js --build",
    "dev": "node --watch --env-file-if-exists=.env backend/src/server.js",
    "dev:lan": "node --watch --env-file-if-exists=.env backend/src/server.js --lan",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "seed": "node --env-file-if-exists=.env database/seed-data.js",
    "db:check": "node --env-file-if-exists=.env database/check-connection.js",
    "mqtt:sample": "node backend/scripts/mqtt-sample.js",
    "ai:demo": "node backend/scripts/ai-demo.js",
    "migrate:sqlite": "node --env-file-if-exists=.env database/migrate-sqlite.js",
    "build": "tailwindcss -i ./frontend/styles.css -o ./frontend/public/assets/app.css --minify",
    "css:watch": "tailwindcss -i ./frontend/styles.css -o ./frontend/public/assets/app.css --watch",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/homes.test.js tests/migration.test.js tests/ai.test.js tests/ai-api.test.js tests/gas.test.js tests/multisensor.test.js",
    "test:ui": "node tests/browser.mjs",
    "test:home-ui": "node tests/home-browser.mjs",
    "test:gas-ui": "node tests/gas-browser.mjs",
    "test:remote-ui": "node tests/remote-browser.mjs",
    "test:ai-ui": "node tests/ai-browser.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.12.0",
    "mqtt": "^5.14.1",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.1.0"
  }
}
