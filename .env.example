PORT=3080
HOST=127.0.0.1
DEMO_MODE=true
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/iot_admin?retryWrites=true&w=majority
MONGODB_DB_NAME=iot_admin
# Optional: override DNS for this Node process if Atlas SRV/TXT lookup is refused.
MONGODB_DNS_SERVERS=
# Required outside demo mode: generate a long random value, at least 32 characters.
SESSION_SECRET=
ADMIN_EMAIL=admin@nodo.local
ADMIN_PASSWORD=
# Set NODE_ENV=production only behind HTTPS; secure session cookies are then enabled.
NODE_ENV=development
# Only set to 1 when running behind one trusted reverse proxy.
TRUST_PROXY=0

# Real MQTT mode: DEMO_MODE=false. Use mqtts:// and certificate validation.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartroom
# Enable only after Mosquitto Dynamic Security is installed and configured.
# The backend MQTT account must have administrative access to its control topics.
MQTT_DYNAMIC_SECURITY=false
